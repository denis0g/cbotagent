# Backend PostgreSQL connection string
ConnectionStrings__PostgresConnectionUrl=Host=localhost;Port=5432;Username=postgres;Password=change-me;Database=cbot

# Backend JWT signing key (use a long random secret)
Jwt__SecurityKey=replace-with-a-long-random-secret

# Google Gemini API key
Gemini__ApiKey=replace-with-your-gemini-api-key

# Docker daemon settings for cTrader compilation
CTrader__DockerImage=mcr.microsoft.com/dotnet/sdk:10.0-alpine
# Must be a Docker-host-visible bind-mounted path if the backend itself runs in Docker.
CTrader__BuildRoot=/home/dn/ctrader-builds
CTrader__BuildTimeoutMinutes=5
# Source files are stored in this directory. Mount it persistently when the backend runs in Docker.
CTrader__BotDirectory=/home/dn/ctrader-bots
# .algo artifacts are stored under the backend content root by default (backend/Algos).
CTrader__AlgoDirectory=Algos
# Spotware cTrader CLI backtesting image and persisted reports
CTrader__BacktestImage=ghcr.io/spotware/ctrader-console:latest
CTrader__BacktestTimeoutMinutes=60
CTrader__BacktestDirectory=/home/dn/ctrader-backtests

# Frontend API base URL, without a trailing slash
FRONTEND_API_URL=http://localhost:5214
